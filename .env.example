# Copy to .env and fill in. .env is ignored by git. Never put real keys in this file.

# Provider: bedrock | anthropic | gemini (default: anthropic if its key is set, else gemini, else bedrock)
# AGENTGUARD_PROVIDER=bedrock

# Amazon Bedrock (standard AWS credentials; enable the model in the Bedrock console first)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=            # alternative to access keys: a Bedrock API key
# AGENTGUARD_BEDROCK_MODEL=anthropic.claude-opus-5-5

# Anthropic API
# ANTHROPIC_API_KEY=
# AGENTGUARD_MODEL=claude-opus-5-5

# Gemini
# GEMINI_API_KEY=
# AGENTGUARD_GEMINI_MODEL=gemini-3.8-flash
